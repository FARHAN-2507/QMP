GROQ_API_KEYS=key1,key2,key3
GROQ_MODEL=openai/gpt-oss-20b
MONGODB_CONNECTION_STRING=
MONGODB_DATABASE_NAME=QueryMind
QUERYMIND_ENVIRONMENT=development
QUERYMIND_MAX_AGENT_ITERATIONS=20
QUERYMIND_HTTP_TIMEOUT_SECONDS=30
# ApiSmokeTesting (optional)
QUERYMIND_SMOKE_TIMEOUT_SECONDS=30
QUERYMIND_SMOKE_RESPONSE_TIME_WARNING_MS=500
QUERYMIND_SMOKE_RESPONSE_TIME_FAILURE_MS=1000
QUERYMIND_SMOKE_EXPECTED_STATUS_CODES=200,201,202,204
QUERYMIND_SMOKE_ENABLE_SECURITY_HEADERS=true
QUERYMIND_SMOKE_ENABLE_HTTPS_CHECK=true
QUERYMIND_SMOKE_ENABLE_ERROR_PATTERNS=true
